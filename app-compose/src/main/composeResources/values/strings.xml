    <string name="fan_limits_title">Hardware Power Limits</string>
    <string name="fan_limits_desc">Electrical and safety limits stored in controller EEPROM (Report 0x03). In Curve mode, controller firmware proportionally scales output between Minimum and Maximum Power.</string>
